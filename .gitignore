# Entornos virtuales
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Datos: NO se suben (se descargan con el script/README). Se conserva .gitkeep
data/*
!data/.gitkeep
# Los hashes y las particiones SÍ se versionan (son pequeños y prueban el test congelado)
!data/splits/
!data/splits/**
!data/SHA256SUMS.txt

# Modelos / checkpoints (pesados)
models/*
!models/.gitkeep
*.keras
*.h5
*.ckpt
*.weights.h5
*.pt
*.pth

# Resultados: se versionan tablas pequeñas (csv/json/yaml); se ignoran binarios y logs pesados
results/**/*.npy
results/**/*.npz
results/**/events.out.tfevents.*
results/**/tensorboard/
logs/

# Jupyter Book
reports/_build/
_build/

# Sistema / editores
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
.idea/

# Secretos
.env
*.key

docs/_build/
.ipynb_checkpoints/
