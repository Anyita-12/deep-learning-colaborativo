    <bib:Article rdf:about="#item_281">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf rdf:resource="urn:issn:21961115"/>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
