    <rdf:Description rdf:about="#item_183">
        <z:itemType>conferencePaper</z:itemType>
        <dcterms:isPartOf>
            <bib:Journal>
                <dc:identifier>DOI 10.1109/dasc-picom-cbdcom-cyberscitech49142.2020.00108</dc:identifier>
            </bib:Journal>
