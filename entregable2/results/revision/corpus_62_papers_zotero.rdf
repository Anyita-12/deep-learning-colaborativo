        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                       <foaf:surname>Maleknya K.</foaf:surname>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                       <foaf:surname>Alizadehsani R.</foaf:surname>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
