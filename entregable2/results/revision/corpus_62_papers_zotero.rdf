    <bib:Article rdf:about="#item_193">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf rdf:resource="urn:issn:1618954X"/>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                   <foaf:Person><foaf:surname>Devi A.</foaf:surname></foaf:Person>
                </rdf:li>
