    <bib:Article rdf:about="#item_243">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf>
            <bib:Journal>
                <dc:title>Sustainability (Switzerland)</dc:title>
                <dc:identifier>DOI 10.3390/su16156500</dc:identifier>
                <dcterms:alternative>Sustainability (Switzerland)</dcterms:alternative>
                <dc:identifier>ISSN 20711050</dc:identifier>
