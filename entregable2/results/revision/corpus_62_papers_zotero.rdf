    <bib:Article rdf:about="#item_213">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf rdf:resource="urn:issn:1387585X"/>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                   <foaf:Person><foaf:surname>Goel S.</foaf:surname></foaf:Person>
