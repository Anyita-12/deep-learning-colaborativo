    <bib:Article rdf:about="#item_167">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf rdf:resource="urn:issn:09441344"/>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                       <foaf:surname>Sayed G.I.</foaf:surname>
                    </foaf:Person>
