    <bib:Article rdf:about="#item_135">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf rdf:resource="urn:issn:20763417"/>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                   <foaf:Person><foaf:surname>Shi C.</foaf:surname></foaf:Person>
                </rdf:li>
                <rdf:li>
                   <foaf:Person><foaf:surname>Tan C.</foaf:surname></foaf:Person>
