    <bib:Article rdf:about="#item_263">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf>
            <bib:Journal>
                <dc:title>Scientific Reports</dc:title>
                <dc:identifier>DOI 10.1038/s41598-026-46347-7</dc:identifier>
                <dcterms:alternative>Scientific Reports</dcterms:alternative>
