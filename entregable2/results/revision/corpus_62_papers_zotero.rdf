    <bib:Article rdf:about="#item_137">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf rdf:resource="urn:issn:09596526"/>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                       <foaf:surname>Mao W.-L.</foaf:surname>
                    </foaf:Person>
