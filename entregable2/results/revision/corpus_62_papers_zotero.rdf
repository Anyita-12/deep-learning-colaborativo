    <bib:Article rdf:about="#item_191">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf>
            <bib:Journal>
                <dc:title>Sustainability (Switzerland)</dc:title>
                <dc:identifier>DOI 10.3390/su142214735</dc:identifier>
