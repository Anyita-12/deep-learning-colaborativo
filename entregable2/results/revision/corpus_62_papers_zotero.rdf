                       <foaf:surname>Chen W.-C.</foaf:surname>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                       <foaf:surname>Fathurrahman H.I.K.</foaf:surname>
                    </foaf:Person>
